# Export these with your shell or hosting platform. The application does not auto-load .env.
APP_SECRET=replace-with-a-long-random-value
# Local development uses HTTP; production must use HTTPS and COOKIE_SECURE=1.
COOKIE_SECURE=0
PORT=5000
# Default: never makes an external WhatsApp request.
WHATSAPP_MODE=dry-run
# Only configure live after obtaining opt-in and verifying recipient numbers.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=blood_donor_request
WHATSAPP_TEMPLATE_LANGUAGE=en
# Set a currently supported Graph API version for your Meta app.
WHATSAPP_API_VERSION=v23.0
